              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/1/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "1",
                "reviews"
              ]
            },
            "description": "O front mostra só o nome do autor. Veja o que a API realmente devolve.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Meu perfil",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
