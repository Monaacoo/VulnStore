            "description": "Só troquei o ID.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Pedido por ID — use no Runner com ids-pedidos.csv",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}"
              ]
            },
            "description": "Run collection → selecione só esta requisição → Data: postman/ids-pedidos.csv. Cada iteração troca o {{orderId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = pm.iterationData.get('orderId') || pm.collectionVariables.get('orderId');",
                  "let info = '';",
                  "try { const b = pm.response.json(); if (b.customer) info = b.customer.name + ' | ' + b.shippingAddress; } catch (e) {}",
                  "console.log(`#${id} -> ${pm.response.code} ${info}`);",
                  "pm.test(`pedido ${id} -> ${pm.response.code} ${info}`, () => true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancelar pedido da Ana (1001)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/1001/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "1001",
                "cancel"
              ]
            },
            "description": "BOLA também vale para escrita.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
