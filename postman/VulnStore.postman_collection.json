{
  "info": {
    "name": "VulnStore — Segurança em APIs REST",
    "description": "Coleção da demo da palestra. Troque {{baseUrl}} entre http://127.0.0.1:3000 (vulnerável) e http://127.0.0.1:3001 (corrigida).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "orderId",
      "value": "1002"
    }
  ],
  "item": [
    {
      "name": "00 — Setup",
      "item": [
        {
          "name": "Health check (mostra o modo)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Resetar laboratório",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/__reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "__reset"
              ]
            },
            "description": "Restaura a base. Use entre ensaios.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login como João (atacante)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Salva o JWT em {{token}}. Observe também o objeto 'user' da resposta.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joao@vulnstore.test\",\n  \"password\": \"joao123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.token) { pm.collectionVariables.set('token', r.token); console.log('token salvo'); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Meus pedidos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "01 — Excessive Data Exposure",
      "item": [
